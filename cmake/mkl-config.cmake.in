@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# BLAS is a public dependency of mkl
find_dependency(BLAS)

if(NOT TARGET BLAS::BLAS AND BLAS_LIBRARIES)
  add_library(BLAS::BLAS INTERFACE IMPORTED)
  set_target_properties(BLAS::BLAS PROPERTIES
    INTERFACE_LINK_LIBRARIES "${BLAS_LIBRARIES}"
  )
  if(BLAS_INCLUDE_DIRS)
    set_target_properties(BLAS::BLAS PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${BLAS_INCLUDE_DIRS}"
    )
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mkl-targets.cmake")

check_required_components(mkl)
